<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DuplicateFinder.Desktop"
        x:Class="DuplicateFinder.Desktop.MainWindow" x:CompileBindings="True"
        Title="DuplicateFinder"
        Width="1120" Height="740" MinWidth="920" MinHeight="660"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource WorkspaceForeground}">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="DuplicateFinder" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="Find matching files. Review what stays." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Name="DiagnosticsButton" Click="DiagnosticsButton_Click" AutomationProperties.Name="Local diagnostics; Diagnostics Off">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Name="DiagnosticsIndicator" Classes="diagnosticsIndicator" />
                        <TextBlock Name="DiagnosticsLabel" Text="Diagnostics Off" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ComboBox Name="AppearanceBox" Width="130" AutomationProperties.Name="Application appearance" SelectionChanged="AppearanceBox_SelectionChanged" />
            <Border Background="{DynamicResource WorkspaceBadge}" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="EXACT FILE MATCHES" Foreground="{DynamicResource WorkspaceAccentText}" FontSize="12" FontWeight="SemiBold" />
            </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Name="ScanSetupPanel" Background="{DynamicResource WorkspacePanel}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="Scan folders" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Name="ManageFoldersButton" Content="Folders (0)" Click="ManageFoldersButton_Click" />
                    <Button Grid.Column="2" Name="ScanSettingsButton" Content="Scan settings" Click="ScanSettingsButton_Click" />
                </Grid>
                <Grid Grid.Row="1" Name="ScanToolbar" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6" SizeChanged="ScanToolbar_SizeChanged">
                  <Grid Name="FolderEntryPanel" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Name="RootPathBox" PlaceholderText="Enter a folder or drive path to add" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Folder to add" TextChanged="ScanSetup_Changed" />
                    <Button Grid.Column="1" Name="AddFolderButton" Content="Add" Click="AddFolderButton_Click" />
                    <Button Grid.Column="2" Name="BrowseButton" Content="Browse" Click="BrowseButton_Click" />
                  </Grid>
                  <StackPanel Grid.Column="1" Name="FileTypePanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="File type" VerticalAlignment="Center" />
                    <ComboBox Name="FileTypeBox" Width="180" AutomationProperties.Name="File type filter" SelectionChanged="FileTypeBox_SelectionChanged" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Name="ScanActionsPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="ScanButton" Content="Scan folders" Click="ScanButton_Click"
                            Background="{DynamicResource WorkspaceAccent}" Foreground="{DynamicResource WorkspaceOnAccent}" FontWeight="SemiBold" />
                    <Button Name="CancelScanButton" Content="Cancel" Click="CancelScanButton_Click" IsEnabled="False" ToolTip.Tip="Cancel the scan (Escape)" AutomationProperties.Name="Cancel scan" />
                  </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" Name="SelectedFoldersText" Classes="muted" FontSize="13"
                           Text="No folders selected. Add a folder or drive."
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
                <Grid Grid.Row="3" Name="CustomExtensionsPanel" IsVisible="False" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="6">
                    <TextBlock Classes="muted" Text="Extensions" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Name="ExtensionsBox" PlaceholderText="All file extensions" IsReadOnly="True"
                             AutomationProperties.Name="Included file extensions" TextChanged="ScanSetup_Changed" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted"
                               Text="Enter extensions separated by commas. Every category uses exact content matching."
                               TextWrapping="Wrap" FontSize="13" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
            <TextBlock Text="Scan results" FontSize="18" FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <TextBlock><Run Name="GroupCountText" Text="0" /><Run Text=" groups" /></TextBlock>
                <TextBlock><Run Name="DuplicateFileCountText" Text="0" /><Run Text=" files in groups" /></TextBlock>
                <TextBlock Foreground="{DynamicResource WorkspaceAccentText}" ToolTip.Tip="Content in extra copies. Quarantine does not free disk space."><Run Name="ReclaimableText" Text="0 B" /><Run Text=" extra-copy content" /></TextBlock>
            </StackPanel>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Name="ScanWarningPanel" IsVisible="False" Classes="reviewSection" Padding="10,6" BorderBrush="{DynamicResource WorkspaceWarning}">
                <TextBlock Name="ScanWarningText" IsVisible="False" Foreground="{DynamicResource WorkspaceWarning}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource WorkspaceInset}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Margin="14,10" Classes="section" Text="Duplicate groups" />
                    <StackPanel Grid.Row="1" Margin="12,0,12,8" Spacing="6">
                        <TextBox Name="ResultsSearchBox" PlaceholderText="Search names or paths" AutomationProperties.Name="Search duplicate groups" ToolTip.Tip="Search filenames and paths (Ctrl+F)" TextChanged="ResultsSearch_Changed" />
                        <ComboBox Name="ResultsSortBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort duplicate groups" SelectionChanged="ResultsSort_Changed" />
                        <TextBlock Name="VisibleGroupsText" Classes="muted" FontSize="12" Text="0 of 0 groups" />
                    </StackPanel>
                    <ListBox Grid.Row="2" Name="ResultsList" Background="Transparent" SelectionChanged="ResultsList_SelectionChanged"
                             AutomationProperties.Name="Duplicate groups">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:DuplicateGroupItem">
                                <StackPanel Spacing="5">
                                    <TextBlock IsVisible="{Binding !CanCompareImage}" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                    <Button IsVisible="{Binding CanCompareImage}" Classes="imageLink" Click="GroupImageLink_Click"
                                            AutomationProperties.Name="{Binding PreviewAccessibleName}" AutomationProperties.AutomationId="GroupImageLink"
                                            ToolTip.Tip="Compare images in this group. The file to keep stays unchanged.">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextDecorations="Underline" FontWeight="SemiBold" />
                                    </Button>
                                    <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="13" />
                                    <TextBlock Text="{Binding Reclaimable}" Foreground="{DynamicResource WorkspaceAccentText}" FontSize="13" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Name="EmptyResultsText" Margin="22" Classes="muted" Text="Add folders above, then choose Scan folders."
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"
                          MinWidth="6"
                          AutomationProperties.Name="Resize group and file panels" />
            <Border Grid.Column="2" Background="{DynamicResource WorkspacePanel}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
                    <TextBlock Name="SelectedGroupTitle" Text="All duplicate groups" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="File to keep" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Name="KeepFileComboBox" HorizontalAlignment="Stretch" IsEnabled="False"
                                  AutomationProperties.Name="File to keep" ToolTip.Tip="Keep one file. Review the remaining copies before confirming removal.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:KeepFileChoice">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <ListBox Grid.Row="2" Name="GroupFilesList" Background="Transparent" SelectionMode="Single"
                             AutomationProperties.Name="All duplicate groups and files; cleanup applies only to the active group">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="local:ReviewGroupHeader" x:DataType="local:ReviewGroupHeader">
                                <Border Background="{DynamicResource WorkspaceInset}" BorderBrush="{DynamicResource WorkspaceBorder}"
                                        BorderThickness="0,1,0,1" Padding="10,8" Margin="0,6,0,0">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Review group" Click="ReviewGroupButton_Click"
                                                AutomationProperties.AutomationId="ReviewGroupButton" ToolTip.Tip="Make this group active for the keep selector and removal review." />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="local:FileReviewRow" x:DataType="local:FileReviewRow">
                                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12" AutomationProperties.Name="{Binding AccessibleName}">
                                    <Border Width="64" Height="64" Background="{DynamicResource WorkspaceInset}" CornerRadius="6">
                                        <TextBlock Text="FILE" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock IsVisible="{Binding !CanCompareImage}" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Button IsVisible="{Binding CanCompareImage}" Classes="imageLink" Click="FileImageLink_Click"
                                                AutomationProperties.Name="{Binding PreviewAccessibleName}" AutomationProperties.AutomationId="FileImageLink"
                                                ToolTip.Tip="Compare this image with the other copies. The file to keep stays unchanged.">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" TextDecorations="Underline" FontWeight="SemiBold" />
                                        </Button>
                                        <TextBlock Text="{Binding FullPath}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                        <Border IsVisible="{Binding IsKeep}" Background="{DynamicResource WorkspaceBadge}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="KEPT FILE" Foreground="{DynamicResource WorkspaceAccentText}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock IsVisible="{Binding IsRemovalCandidate}" Text="Extra copy ? review before removal" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Size}" Classes="muted" FontSize="13" HorizontalAlignment="Right" />
                                        <Button IsVisible="{Binding IsRemovalCandidate}" Content="Keep this file" Click="KeepFileButton_Click" Padding="8,4" MinHeight="30"
                                                AutomationProperties.Name="{Binding KeepAccessibleName}" AutomationProperties.AutomationId="KeepThisFileButton" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Name="ReviewText" Text="No review selected." Classes="muted" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Name="PreviewFileButton" Content="Preview file" AutomationProperties.Name="Preview selected file" Padding="10,6" Click="PreviewFileButton_Click" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource WorkspaceInset}" CornerRadius="10" Padding="12,8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                <TextBlock Grid.ColumnSpan="3" Name="StatusText" Text="Ready to scan. Nothing is removed automatically." VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.Name="Scan and operation status" />
                <ComboBox Grid.Row="1" Name="CleanupActionBox" SelectedIndex="0" SelectionChanged="CleanupActionBox_SelectionChanged"
                          Width="240" AutomationProperties.Name="Cleanup action">
                    <ComboBoxItem Content="Quarantine (recoverable)" />
                    <ComboBoxItem Content="Permanently delete" />
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="1" Name="RestoreBatchButton" Content="Restore batch" Click="RestoreBatchButton_Click" />
                <Button Grid.Row="1" Grid.Column="2" Name="CleanupButton" Content="Review active group" Click="CleanupButton_Click" IsEnabled="False"
                        Background="{DynamicResource WorkspaceDanger}" Foreground="{DynamicResource WorkspaceOnDanger}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Name="RecoveryText" IsVisible="False" Classes="muted" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Spacing="6">
                    <TextBlock Name="ScanWorkText" IsVisible="False" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                    <ProgressBar Name="ScanProgressIndicator" Height="3" IsIndeterminate="True" IsVisible="False" AutomationProperties.Name="Operation in progress; total work unknown" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
