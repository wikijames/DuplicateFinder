<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DuplicateFinder.Desktop"
        x:Class="DuplicateFinder.Desktop.MainWindow"
        Title="DuplicateFinder"
        Width="1120" Height="740" MinWidth="920" MinHeight="660"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource WorkspaceForeground}">
    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Styles>
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="DuplicateFinder" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="Find matching files. Review what stays." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Name="DiagnosticsButton" Content="Diagnostics: off" Click="DiagnosticsButton_Click" AutomationProperties.Name="Local diagnostic recording" />
                <ComboBox Name="AppearanceBox" Width="130" AutomationProperties.Name="Application appearance" SelectionChanged="AppearanceBox_SelectionChanged" />
            <Border Background="{DynamicResource WorkspaceBadge}" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="EXACT FILE MATCHES" Foreground="{DynamicResource WorkspaceAccentText}" FontSize="11" FontWeight="SemiBold" />
            </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Name="ScanSetupPanel" Background="{DynamicResource WorkspacePanel}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="Scan folders" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Name="ManageFoldersButton" Content="Folders (0)" Click="ManageFoldersButton_Click" />
                    <Button Grid.Column="2" Name="ScanSettingsButton" Content="Scan settings" Click="ScanSettingsButton_Click" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox Name="RootPathBox" PlaceholderText="Enter a folder path or drop folders here" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Folder to add" TextChanged="ScanSetup_Changed" />
                    <Button Grid.Column="1" Name="AddFolderButton" Content="Add" Click="AddFolderButton_Click" />
                    <Button Grid.Column="2" Name="BrowseButton" Content="Browse" Click="BrowseButton_Click" />
                    <Button Grid.Column="3" Name="ScanButton" Content="Scan folders" Click="ScanButton_Click"
                            Background="{DynamicResource WorkspaceAccent}" Foreground="{DynamicResource WorkspaceOnAccent}" FontWeight="SemiBold" />
                    <Button Grid.Column="4" Name="CancelScanButton" Content="Cancel" Click="CancelScanButton_Click" IsEnabled="False" ToolTip.Tip="Cancel the scan (Escape)" AutomationProperties.Name="Cancel scan" />
                </Grid>
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,180,*" ColumnSpacing="12" RowSpacing="6">
                    <TextBlock Classes="muted" Text="File type" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Name="FileTypeBox" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="File type filter" SelectionChanged="FileTypeBox_SelectionChanged" />
                    <TextBox Grid.Column="2" Name="ExtensionsBox" PlaceholderText="All file extensions" IsReadOnly="True"
                             AutomationProperties.Name="Included file extensions" TextChanged="ScanSetup_Changed" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted"
                               Text="Choose Custom extensions to edit the list. Every category uses exact content matching."
                               TextWrapping="Wrap" FontSize="12" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
            <TextBlock Text="Scan results" FontSize="18" FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <TextBlock><Run Name="GroupCountText" Text="0" /><Run Text=" groups" /></TextBlock>
                <TextBlock><Run Name="DuplicateFileCountText" Text="0" /><Run Text=" files" /></TextBlock>
                <TextBlock Foreground="{DynamicResource WorkspaceAccentText}"><Run Name="ReclaimableText" Text="0 B" /><Run Text=" in extra copies" /></TextBlock>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Name="ScanWarningText" IsVisible="False" Foreground="{DynamicResource WorkspaceWarning}"
                       FontSize="12" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="300,12,*">
            <Border Background="{DynamicResource WorkspaceInset}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Margin="16,14" Classes="muted" Text="DUPLICATE GROUPS" FontSize="11" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Margin="12,0,12,8" Spacing="6">
                        <TextBox Name="ResultsSearchBox" PlaceholderText="Search names or paths" AutomationProperties.Name="Search duplicate groups" ToolTip.Tip="Search filenames and paths (Ctrl+F)" TextChanged="ResultsSearch_Changed" />
                        <ComboBox Name="ResultsSortBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort duplicate groups" SelectionChanged="ResultsSort_Changed" />
                        <TextBlock Name="VisibleGroupsText" Classes="muted" FontSize="11" Text="0 of 0 groups" />
                    </StackPanel>
                    <ListBox Grid.Row="2" Name="ResultsList" Background="Transparent" SelectionChanged="ResultsList_SelectionChanged"
                             AutomationProperties.Name="Duplicate groups">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:DuplicateGroupItem">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding Reclaimable}" Foreground="{DynamicResource WorkspaceAccentText}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Name="EmptyResultsText" Margin="22" Classes="muted" Text="Choose a folder and start a scan."
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"
                          AutomationProperties.Name="Resize group and file panels" />
            <Border Grid.Column="2" Background="{DynamicResource WorkspacePanel}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
                    <TextBlock Name="SelectedGroupTitle" Text="Choose a duplicate group" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="Keep file" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Name="KeepFileComboBox" HorizontalAlignment="Stretch" IsEnabled="False"
                                  AutomationProperties.Name="File to keep" ToolTip.Tip="Keep one file. Review the remaining copies before confirming removal.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:KeepFileChoice">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <ListBox Grid.Row="2" Name="GroupFilesList" Background="Transparent" SelectionMode="Single"
                             AutomationProperties.Name="Files in selected group">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:DuplicateFileItem">
                                <StackPanel Spacing="5" Margin="0,3">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="muted" FontSize="12" />
                                    </Grid>
                                    <TextBlock Text="{Binding FullPath}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Disposition}" Foreground="{DynamicResource WorkspaceAccentText}" FontSize="10" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Name="ReviewText" Text="No review selected." Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Name="PreviewFileButton" Content="Preview file" AutomationProperties.Name="Preview selected file" Padding="10,6" Click="PreviewFileButton_Click" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource WorkspaceInset}" CornerRadius="10" Padding="12,8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                <TextBlock Grid.ColumnSpan="3" Name="StatusText" Text="Ready to scan. Nothing is removed automatically." VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.Name="Scan and operation status" />
                <ComboBox Grid.Row="1" Name="CleanupActionBox" SelectedIndex="0" SelectionChanged="CleanupActionBox_SelectionChanged"
                          Width="240" AutomationProperties.Name="Cleanup action">
                    <ComboBoxItem Content="Quarantine (recoverable)" />
                    <ComboBoxItem Content="Permanently delete" />
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="1" Name="RestoreBatchButton" Content="Restore batch" Click="RestoreBatchButton_Click" />
                <Button Grid.Row="1" Grid.Column="2" Name="CleanupButton" Content="Review removal" Click="CleanupButton_Click" IsEnabled="False"
                        Background="{DynamicResource WorkspaceDanger}" Foreground="{DynamicResource WorkspaceOnDanger}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Name="RecoveryText" IsVisible="False" Classes="muted" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Row="3" Grid.ColumnSpan="3" Name="ScanProgressIndicator" Height="3" IsIndeterminate="True" IsVisible="False" AutomationProperties.Name="Operation in progress; total work unknown" />
            </Grid>
        </Border>
    </Grid>
</Window>
