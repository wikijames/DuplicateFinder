<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DuplicateFinder.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WorkspaceBackground">#111A23</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceForeground">#EEF3F7</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceMuted">#AAB9C7</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspacePanel">#1A2632</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceInset">#17232E</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceBorder">#304150</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceBadge">#193D3A</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccentText">#8EE2D4</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccent">#77D4C3</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceOnAccent">#102722</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceDanger">#58363B</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceOnDanger">#FFE2E2</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceWarning">#F1C777</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSelection">#25454D</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceFocus">#9CD7FF</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkspaceBackground">#F1F5F8</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceForeground">#162534</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceMuted">#485B6B</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspacePanel">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceInset">#E7EEF3</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceBorder">#8295A5</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceBadge">#D3ECE5</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccentText">#075C50</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccent">#116B5D</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceOnAccent">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceDanger">#812D3A</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceOnDanger">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceWarning">#714900</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSelection">#D4E9EC</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceFocus">#005A9C</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceForeground}" />
        </Style>
        <Style Selector="Border.reviewSection">
            <Setter Property="Background" Value="{DynamicResource WorkspaceInset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource WorkspaceAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceOnAccent}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource WorkspaceDanger}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceOnDanger}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}" />
        </Style>
        <Style Selector="TextBox:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}" />
        </Style>
        <Style Selector="ComboBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource WorkspaceSelection}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceForeground}" />
        </Style>
        <Style Selector="ListBoxItem:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}" />
        </Style>
    </Application.Styles>
</Application>
